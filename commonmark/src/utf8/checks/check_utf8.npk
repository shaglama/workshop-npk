// Check harness for Part 2 — cm_utf8.
// Written by Neon (Google).
//
// Exercises every function in commonmark/INTERFACES.md Part 2 against hand-computed
// Unicode / CommonMark 0.31.2 / cmark expected values.

mod:check_utf8;

use "../../buffer/cm_buffer.npk".{
    Buffer, Chunk, buffer_create, buffer_putc, buffer_puts, buffer_len, buffer_clear, buffer_detach,
    chunk_of, chunk_all
};
use "../cm_utf8.npk".{
    Utf8Char, utf8_iterate, utf8_encode, utf8_check,
    utf8_is_space, utf8_is_punct, utf8_case_fold
};

func:print_line = NIL(string:s) never fails {
    fd:out = 1i32 =>! fd;
    Result<int64>:r = write(out, s.ptr, s.len);
    if (r.is_error) { }
    pass NIL;
};

func:put_bytes = NIL(Buffer->:b, fixed int64[]:xs) {
    for (int64:i in 0i64...xs.len) {
        discard(relay buffer_putc(b, xs[i]));
    }
    pass NIL;
};

func:mk_bytes = string(fixed int64[]:xs) {
    Buffer:b = relay buffer_create();
    discard(relay put_bytes(@b, xs));
    pass (raw buffer_detach(move(b)));
};

func:expect_iter = bool(string:base, Chunk:c, int64:pos, int64:exp_cp, int64:exp_w) never fails {
    Utf8Char:ch = raw utf8_iterate(base, c, pos);
    pass (ch.cp == exp_cp && ch.width == exp_w);
};

func:expect_encode = bool(int64:cp, fixed int64[]:exp_bytes) {
    Buffer:b = relay buffer_create();
    discard(relay utf8_encode(cp, @b));
    string:got = raw buffer_detach(move(b));
    string:exp = relay mk_bytes(exp_bytes);
    pass string_equals(got, exp);
};

func:expect_check = bool(string:base, Chunk:c, string:expected) {
    Buffer:b = relay buffer_create();
    discard(relay utf8_check(base, c, @b));
    string:got = raw buffer_detach(move(b));
    pass string_equals(got, expected);
};

func:expect_fold = bool(string:base, Chunk:c, string:expected) {
    Buffer:b = relay buffer_create();
    discard(relay utf8_case_fold(base, c, @b));
    string:got = raw buffer_detach(move(b));
    pass string_equals(got, expected);
};

func:test_iterate = int32() {
    // Empty string & bounds
    string:empty = "";
    Chunk:ce = raw chunk_all(empty);
    if (!(raw expect_iter(empty, ce, 0i64, 0i64, 0i64))) { pass 10i32; }
    if (!(raw expect_iter(empty, ce, 1i64, 0i64, 0i64))) { pass 11i32; }
    if (!(raw expect_iter(empty, ce, 0i64 - 1i64, 0i64, 0i64))) { pass 12i32; }

    // ASCII including NUL (0x00), 'A' (0x41), DEL (0x7F)
    fixed int64[3]:ascii_bs = [0i64, 65i64, 127i64];
    string:ascii = relay mk_bytes(ascii_bs[0i64...3i64]);
    Chunk:ca = raw chunk_all(ascii);
    if (!(raw expect_iter(ascii, ca, 0i64, 0i64, 1i64))) { pass 13i32; }
    if (!(raw expect_iter(ascii, ca, 1i64, 65i64, 1i64))) { pass 14i32; }
    if (!(raw expect_iter(ascii, ca, 2i64, 127i64, 1i64))) { pass 15i32; }
    if (!(raw expect_iter(ascii, ca, 3i64, 0i64, 0i64))) { pass 16i32; }

    // Valid multi-byte boundaries:
    // U+0080 (C2 80), U+00E9 (C3 A9), U+07FF (DF BF),
    // U+0800 (E0 A0 80), U+20AC (E2 82 AC), U+D7FF (ED 9F BF),
    // U+E000 (EE 80 80), U+FFFD (EF BF BD), U+FFFE (EF BF BE), U+FFFF (EF BF BF),
    // U+10000 (F0 90 80 80), U+1F600 (F0 9F 98 80), U+10FFFF (F4 8F BF BF)
    fixed int64[39]:mb_bs = [
        194i64, 128i64,
        195i64, 169i64,
        223i64, 191i64,
        224i64, 160i64, 128i64,
        226i64, 130i64, 172i64,
        237i64, 159i64, 191i64,
        238i64, 128i64, 128i64,
        239i64, 191i64, 189i64,
        239i64, 191i64, 190i64,
        239i64, 191i64, 191i64,
        240i64, 144i64, 128i64, 128i64,
        240i64, 159i64, 152i64, 128i64,
        244i64, 143i64, 191i64, 191i64
    ];
    string:mb = relay mk_bytes(mb_bs[0i64...39i64]);
    Chunk:cmb = raw chunk_all(mb);
    if (!(raw expect_iter(mb, cmb, 0i64, 128i64, 2i64))) { pass 17i32; }
    if (!(raw expect_iter(mb, cmb, 2i64, 233i64, 2i64))) { pass 18i32; }
    if (!(raw expect_iter(mb, cmb, 4i64, 2047i64, 2i64))) { pass 19i32; }
    if (!(raw expect_iter(mb, cmb, 6i64, 2048i64, 3i64))) { pass 20i32; }
    if (!(raw expect_iter(mb, cmb, 9i64, 8364i64, 3i64))) { pass 21i32; }
    if (!(raw expect_iter(mb, cmb, 12i64, 55295i64, 3i64))) { pass 22i32; }
    if (!(raw expect_iter(mb, cmb, 15i64, 57344i64, 3i64))) { pass 23i32; }
    if (!(raw expect_iter(mb, cmb, 18i64, 65533i64, 3i64))) { pass 24i32; }
    if (!(raw expect_iter(mb, cmb, 21i64, 65534i64, 3i64))) { pass 25i32; }
    if (!(raw expect_iter(mb, cmb, 24i64, 65535i64, 3i64))) { pass 26i32; }
    if (!(raw expect_iter(mb, cmb, 27i64, 65536i64, 4i64))) { pass 27i32; }
    if (!(raw expect_iter(mb, cmb, 31i64, 128512i64, 4i64))) { pass 28i32; }
    if (!(raw expect_iter(mb, cmb, 35i64, 1114111i64, 4i64))) { pass 29i32; }
    if (!(raw expect_iter(mb, cmb, 39i64, 0i64, 0i64))) { pass 30i32; }

    // Invalid sequences: each must yield { 0xFFFD (65533), 1 }
    fixed int64[1]:b_inv1 = [128i64]; // stray continuation 0x80
    string:inv1 = relay mk_bytes(b_inv1[0i64...1i64]);
    if (!(raw expect_iter(inv1, raw chunk_all(inv1), 0i64, 65533i64, 1i64))) { pass 31i32; }

    fixed int64[2]:b_inv2 = [192i64, 175i64]; // overlong 2-byte C0 AF
    string:inv2 = relay mk_bytes(b_inv2[0i64...2i64]);
    if (!(raw expect_iter(inv2, raw chunk_all(inv2), 0i64, 65533i64, 1i64))) { pass 32i32; }

    fixed int64[2]:b_inv3 = [193i64, 191i64]; // overlong 2-byte C1 BF
    string:inv3 = relay mk_bytes(b_inv3[0i64...2i64]);
    if (!(raw expect_iter(inv3, raw chunk_all(inv3), 0i64, 65533i64, 1i64))) { pass 33i32; }

    fixed int64[3]:b_inv4 = [224i64, 159i64, 191i64]; // overlong 3-byte E0 9F BF
    string:inv4 = relay mk_bytes(b_inv4[0i64...3i64]);
    if (!(raw expect_iter(inv4, raw chunk_all(inv4), 0i64, 65533i64, 1i64))) { pass 34i32; }

    fixed int64[3]:b_inv5 = [237i64, 160i64, 128i64]; // surrogate U+D800 ED A0 80
    string:inv5 = relay mk_bytes(b_inv5[0i64...3i64]);
    if (!(raw expect_iter(inv5, raw chunk_all(inv5), 0i64, 65533i64, 1i64))) { pass 35i32; }

    fixed int64[3]:b_inv6 = [237i64, 191i64, 191i64]; // surrogate U+DFFF ED BF BF
    string:inv6 = relay mk_bytes(b_inv6[0i64...3i64]);
    if (!(raw expect_iter(inv6, raw chunk_all(inv6), 0i64, 65533i64, 1i64))) { pass 36i32; }

    fixed int64[4]:b_inv7 = [240i64, 143i64, 191i64, 191i64]; // overlong 4-byte F0 8F BF BF
    string:inv7 = relay mk_bytes(b_inv7[0i64...4i64]);
    if (!(raw expect_iter(inv7, raw chunk_all(inv7), 0i64, 65533i64, 1i64))) { pass 37i32; }

    fixed int64[4]:b_inv8 = [244i64, 144i64, 128i64, 128i64]; // > U+10FFFF F4 90 80 80
    string:inv8 = relay mk_bytes(b_inv8[0i64...4i64]);
    if (!(raw expect_iter(inv8, raw chunk_all(inv8), 0i64, 65533i64, 1i64))) { pass 38i32; }

    fixed int64[4]:b_inv9 = [245i64, 128i64, 128i64, 128i64]; // F5 80 80 80
    string:inv9 = relay mk_bytes(b_inv9[0i64...4i64]);
    if (!(raw expect_iter(inv9, raw chunk_all(inv9), 0i64, 65533i64, 1i64))) { pass 39i32; }

    fixed int64[2]:b_inv10 = [226i64, 130i64]; // truncated 3-byte E2 82
    string:inv10 = relay mk_bytes(b_inv10[0i64...2i64]);
    if (!(raw expect_iter(inv10, raw chunk_all(inv10), 0i64, 65533i64, 1i64))) { pass 40i32; }

    fixed int64[3]:b_inv11 = [240i64, 159i64, 152i64]; // truncated 4-byte F0 9F 98
    string:inv11 = relay mk_bytes(b_inv11[0i64...3i64]);
    if (!(raw expect_iter(inv11, raw chunk_all(inv11), 0i64, 65533i64, 1i64))) { pass 41i32; }

    // Non-zero chunk offset and strict chunk boundary (must not read past c.off + c.len)
    fixed int64[8]:b_framed = [255i64, 255i64, 195i64, 169i64, 226i64, 130i64, 172i64, 255i64];
    string:framed = relay mk_bytes(b_framed[0i64...8i64]);
    // Slice bytes [2..6): C3 A9 E2 82 (valid é followed by truncated €)
    Chunk:csub = raw chunk_of(framed, 2i64, 4i64);
    if (!(raw expect_iter(framed, csub, 0i64, 233i64, 2i64))) { pass 42i32; }
    if (!(raw expect_iter(framed, csub, 2i64, 65533i64, 1i64))) { pass 43i32; }
    if (!(raw expect_iter(framed, csub, 4i64, 0i64, 0i64))) { pass 44i32; }

    pass 0i32;
};

func:test_encode = int32() {
    fixed int64[1]:e0 = [0i64];
    fixed int64[1]:e1 = [65i64];
    fixed int64[1]:e2 = [127i64];
    fixed int64[2]:e3 = [194i64, 128i64];
    fixed int64[2]:e4 = [195i64, 169i64];
    fixed int64[2]:e5 = [223i64, 191i64];
    fixed int64[3]:e6 = [224i64, 160i64, 128i64];
    fixed int64[3]:e7 = [226i64, 130i64, 172i64];
    fixed int64[3]:e8 = [237i64, 159i64, 191i64];
    fixed int64[3]:e9 = [238i64, 128i64, 128i64];
    fixed int64[3]:e10 = [239i64, 191i64, 189i64];
    fixed int64[3]:e11 = [239i64, 191i64, 190i64];
    fixed int64[3]:e12 = [239i64, 191i64, 191i64];
    fixed int64[4]:e13 = [240i64, 144i64, 128i64, 128i64];
    fixed int64[4]:e14 = [240i64, 159i64, 152i64, 128i64];
    fixed int64[4]:e15 = [244i64, 143i64, 191i64, 191i64];

    if (!(relay expect_encode(0i64, e0[0i64...1i64]))) { pass 50i32; }
    if (!(relay expect_encode(65i64, e1[0i64...1i64]))) { pass 51i32; }
    if (!(relay expect_encode(127i64, e2[0i64...1i64]))) { pass 52i32; }
    if (!(relay expect_encode(128i64, e3[0i64...2i64]))) { pass 53i32; }
    if (!(relay expect_encode(233i64, e4[0i64...2i64]))) { pass 54i32; }
    if (!(relay expect_encode(2047i64, e5[0i64...2i64]))) { pass 55i32; }
    if (!(relay expect_encode(2048i64, e6[0i64...3i64]))) { pass 56i32; }
    if (!(relay expect_encode(8364i64, e7[0i64...3i64]))) { pass 57i32; }
    if (!(relay expect_encode(55295i64, e8[0i64...3i64]))) { pass 58i32; }
    if (!(relay expect_encode(57344i64, e9[0i64...3i64]))) { pass 59i32; }
    if (!(relay expect_encode(65533i64, e10[0i64...3i64]))) { pass 60i32; }
    if (!(relay expect_encode(65534i64, e11[0i64...3i64]))) { pass 61i32; }
    if (!(relay expect_encode(65535i64, e12[0i64...3i64]))) { pass 62i32; }
    if (!(relay expect_encode(65536i64, e13[0i64...4i64]))) { pass 63i32; }
    if (!(relay expect_encode(128512i64, e14[0i64...4i64]))) { pass 64i32; }
    if (!(relay expect_encode(1114111i64, e15[0i64...4i64]))) { pass 65i32; }

    // Invalid scalars map to U+FFFD
    if (!(relay expect_encode(0i64 - 1i64, e10[0i64...3i64]))) { pass 66i32; }
    if (!(relay expect_encode(55296i64, e10[0i64...3i64]))) { pass 67i32; }
    if (!(relay expect_encode(57343i64, e10[0i64...3i64]))) { pass 68i32; }
    if (!(relay expect_encode(1114112i64, e10[0i64...3i64]))) { pass 69i32; }

    // Round-trip encode -> iterate for representative code points
    fixed int64[8]:rt = [0i64, 127i64, 128i64, 2047i64, 2048i64, 65535i64, 65536i64, 1114111i64];
    for (int64:i in 0i64...8i64) {
        Buffer:b = relay buffer_create();
        discard(relay utf8_encode(rt[i], @b));
        string:s = raw buffer_detach(move(b));
        Utf8Char:ch = raw utf8_iterate(s, raw chunk_all(s), 0i64);
        if (ch.cp != rt[i] || ch.width != s.len) { pass 70i32; }
    }

    pass 0i32;
};

func:test_check = int32() {
    fixed int64[3]:fffd_bs = [239i64, 191i64, 189i64];
    string:fffd = relay mk_bytes(fffd_bs[0i64...3i64]);

    // Valid multi-byte text (including U+FFFE and U+FFFF) passes through unchanged
    fixed int64[18]:valid_bs = [
        72i64, 105i64, 32i64,
        195i64, 169i64,
        226i64, 130i64, 172i64,
        239i64, 191i64, 190i64,
        239i64, 191i64, 191i64,
        240i64, 159i64, 152i64, 128i64
    ];
    string:valid = relay mk_bytes(valid_bs[0i64...18i64]);
    if (!(relay expect_check(valid, raw chunk_all(valid), valid))) { pass 80i32; }

    // Empty chunk appends nothing and preserves existing buffer content
    Buffer:pre = relay buffer_create();
    discard(relay buffer_puts(@pre, "keep"));
    discard(relay utf8_check("", raw chunk_all(""), @pre));
    string:kept = raw buffer_detach(move(pre));
    if (!string_equals(kept, "keep")) { pass 81i32; }

    // NUL byte is replaced with U+FFFD (CommonMark / cmark)
    fixed int64[3]:nul_bs = [97i64, 0i64, 98i64];
    string:with_nul = relay mk_bytes(nul_bs[0i64...3i64]);
    string:exp_a_fffd_b = string_concat(string_concat("a", fffd), "b");
    if (!(relay expect_check(with_nul, raw chunk_all(with_nul), exp_a_fffd_b))) { pass 82i32; }

    // Single invalid byte 0xFF
    fixed int64[3]:bad1_bs = [97i64, 255i64, 98i64];
    string:bad1 = relay mk_bytes(bad1_bs[0i64...3i64]);
    if (!(relay expect_check(bad1, raw chunk_all(bad1), exp_a_fffd_b))) { pass 83i32; }

    // Overlong 2-byte C0 AF: cmark utf8proc_valid consumes the whole 2-byte nominal sequence -> one U+FFFD
    fixed int64[2]:ov2_bs = [192i64, 175i64];
    string:ov2 = relay mk_bytes(ov2_bs[0i64...2i64]);
    if (!(relay expect_check(ov2, raw chunk_all(ov2), fffd))) { pass 84i32; }

    // Surrogate U+D800 (ED A0 80): consumes whole 3-byte nominal sequence -> one U+FFFD
    fixed int64[3]:sur_bs = [237i64, 160i64, 128i64];
    string:sur = relay mk_bytes(sur_bs[0i64...3i64]);
    if (!(relay expect_check(sur, raw chunk_all(sur), fffd))) { pass 85i32; }

    // Truncated 3-byte with valid 2-byte prefix + ASCII (E2 82 'a'): bad 3rd byte -> -2 -> ONE U+FFFD then 'a'
    fixed int64[3]:tr3_bs = [226i64, 130i64, 97i64];
    string:tr3 = relay mk_bytes(tr3_bs[0i64...3i64]);
    string:fffd_a = string_concat(fffd, "a");
    if (!(relay expect_check(tr3, raw chunk_all(tr3), fffd_a))) { pass 86i32; }

    // Truncated 4-byte with valid 3-byte prefix + ASCII (F0 9F 98 'a'): bad 4th byte -> -3 -> ONE U+FFFD then 'a'
    fixed int64[4]:tr4_bs = [240i64, 159i64, 152i64, 97i64];
    string:tr4 = relay mk_bytes(tr4_bs[0i64...4i64]);
    if (!(relay expect_check(tr4, raw chunk_all(tr4), fffd_a))) { pass 87i32; }

    // Truncated 4-byte at end of input (F0 9F 98): length 4 > rem 3 -> -3 -> ONE U+FFFD
    fixed int64[3]:tr4end_bs = [240i64, 159i64, 152i64];
    string:tr4end = relay mk_bytes(tr4end_bs[0i64...3i64]);
    if (!(relay expect_check(tr4end, raw chunk_all(tr4end), fffd))) { pass 88i32; }

    // Out of range > U+10FFFF (F4 90 80 80 and F5 80 80 80): whole 4-byte nominal sequence -> one U+FFFD
    fixed int64[4]:hi4_bs = [244i64, 144i64, 128i64, 128i64];
    string:hi4 = relay mk_bytes(hi4_bs[0i64...4i64]);
    if (!(relay expect_check(hi4, raw chunk_all(hi4), fffd))) { pass 89i32; }

    fixed int64[4]:hi5_bs = [245i64, 128i64, 128i64, 128i64];
    string:hi5 = relay mk_bytes(hi5_bs[0i64...4i64]);
    if (!(relay expect_check(hi5, raw chunk_all(hi5), fffd))) { pass 91i32; }

    // Overlong 3-byte (E0 9F BF) and overlong 4-byte (F0 8F BF BF): whole nominal sequence -> one U+FFFD
    fixed int64[3]:ov3_bs = [224i64, 159i64, 191i64];
    string:ov3 = relay mk_bytes(ov3_bs[0i64...3i64]);
    if (!(relay expect_check(ov3, raw chunk_all(ov3), fffd))) { pass 92i32; }

    fixed int64[4]:ov4_bs = [240i64, 143i64, 191i64, 191i64];
    string:ov4 = relay mk_bytes(ov4_bs[0i64...4i64]);
    if (!(relay expect_check(ov4, raw chunk_all(ov4), fffd))) { pass 93i32; }

    // Short nominal sequence at chunk end (E2 41): length 3 > rem 2 -> -2 -> U+FFFD alone
    fixed int64[2]:short3_bs = [226i64, 65i64];
    string:short3 = relay mk_bytes(short3_bs[0i64...2i64]);
    if (!(relay expect_check(short3, raw chunk_all(short3), fffd))) { pass 94i32; }

    // Continuation checked before scalar restriction (E0 80 41): b1=0x80 is continuation, b2='A' is not -> -2 -> U+FFFD + 'A'
    fixed int64[3]:ov3_bad2_bs = [224i64, 128i64, 65i64];
    string:ov3_bad2 = relay mk_bytes(ov3_bad2_bs[0i64...3i64]);
    string:fffd_A = string_concat(fffd, "A");
    if (!(relay expect_check(ov3_bad2, raw chunk_all(ov3_bad2), fffd_A))) { pass 95i32; }

    // Contrast: E2 41 42 has rem=3 >= 3, b1='A' fails continuation -> -1 -> U+FFFD + "AB"
    fixed int64[3]:bad1_3_bs = [226i64, 65i64, 66i64];
    string:bad1_3 = relay mk_bytes(bad1_3_bs[0i64...3i64]);
    string:fffd_AB = string_concat(fffd, "AB");
    if (!(relay expect_check(bad1_3, raw chunk_all(bad1_3), fffd_AB))) { pass 96i32; }

    // Class-4 lead > 0xF4 with non-continuation b1 (F5 41 42 43): continuation checked first -> -1 -> U+FFFD + "ABC"
    fixed int64[4]:f5_bad1_bs = [245i64, 65i64, 66i64, 67i64];
    string:f5_bad1 = relay mk_bytes(f5_bad1_bs[0i64...4i64]);
    string:fffd_ABC = string_concat(fffd, "ABC");
    if (!(relay expect_check(f5_bad1, raw chunk_all(f5_bad1), fffd_ABC))) { pass 97i32; }

    // Invalid lead byte 0xF8 (class 0) followed by 3 continuations -> four U+FFFD
    fixed int64[4]:f8_bs = [248i64, 128i64, 128i64, 128i64];
    string:f8 = relay mk_bytes(f8_bs[0i64...4i64]);
    string:fffd2 = string_concat(fffd, fffd);
    string:fffd4 = string_concat(fffd2, fffd2);
    if (!(relay expect_check(f8, raw chunk_all(f8), fffd4))) { pass 98i32; }

    // Non-zero chunk offset: repair only bytes inside the chunk
    fixed int64[7]:fr_bs = [255i64, 97i64, 98i64, 128i64, 99i64, 100i64, 255i64];
    string:framed = relay mk_bytes(fr_bs[0i64...7i64]);
    string:exp_fr = string_concat(string_concat("ab", fffd), "cd");
    if (!(relay expect_check(framed, raw chunk_of(framed, 1i64, 5i64), exp_fr))) { pass 90i32; }

    // Short nominal sequence at a nonzero chunk offset:
    // base = [0xFF, 'a', 0xE2, 'A', 0x80, 0xFF]; chunk [1..4) = ['a', 0xE2, 'A'].
    // At 'a' -> 'a'; at 0xE2, rem inside chunk is 2 < 3 (must not peek at base[4]=0x80) -> -2 -> "a" + U+FFFD.
    fixed int64[6]:fr_short_bs = [255i64, 97i64, 226i64, 65i64, 128i64, 255i64];
    string:fr_short = relay mk_bytes(fr_short_bs[0i64...6i64]);
    string:a_fffd = string_concat("a", fffd);
    if (!(relay expect_check(fr_short, raw chunk_of(fr_short, 1i64, 3i64), a_fffd))) { pass 99i32; }

    // Valid 3-byte sequence (€ = E2 82 AC) cut short by a nonzero chunk boundary:
    // base = ['a', 0xE2, 0x82, 0xAC, 'b']; chunk [1..3) = [0xE2, 0x82] -> rem 2 < 3 -> one U+FFFD.
    fixed int64[5]:fr_cut_bs = [97i64, 226i64, 130i64, 172i64, 98i64];
    string:fr_cut = relay mk_bytes(fr_cut_bs[0i64...5i64]);
    if (!(relay expect_check(fr_cut, raw chunk_of(fr_cut, 1i64, 2i64), fffd))) { pass 102i32; }

    pass 0i32;
};

func:test_is_space = int32() never fails {
    // All 21 CommonMark / cmark Unicode whitespace code points
    fixed int64[21]:spaces = [
        9i64, 10i64, 12i64, 13i64, 32i64,
        160i64, 5760i64,
        8192i64, 8193i64, 8194i64, 8195i64, 8196i64, 8197i64,
        8198i64, 8199i64, 8200i64, 8201i64, 8202i64,
        8239i64, 8287i64, 12288i64
    ];
    for (int64:i in 0i64...21i64) {
        if (!(raw utf8_is_space(spaces[i]))) { pass 100i32; }
    }

    // Boundary non-space code points (including VT 0x0B, NEL 0x85, MVS 0x180E, ZWSP 0x200B, BOM 0xFEFF)
    fixed int64[22]:non_spaces = [
        0i64 - 1i64, 0i64, 8i64, 11i64, 14i64, 31i64, 33i64,
        133i64, 159i64, 161i64, 5759i64, 5761i64, 6158i64,
        8191i64, 8203i64, 8232i64, 8233i64, 8238i64, 8240i64,
        8286i64, 12289i64, 65279i64
    ];
    for (int64:j in 0i64...22i64) {
        if (raw utf8_is_space(non_spaces[j])) { pass 101i32; }
    }

    pass 0i32;
};

func:test_is_punct = int32() never fails {
    // Exhaustive ASCII check (0..127)
    for (int64:cp in 0i64...128i64) {
        bool:exp = (cp >= 33i64 && cp <= 47i64)
                || (cp >= 58i64 && cp <= 64i64)
                || (cp >= 91i64 && cp <= 96i64)
                || (cp >= 123i64 && cp <= 126i64);
        if ((raw utf8_is_punct(cp)) != exp) { pass 110i32; }
    }

    // Representative Unicode Punctuation (Pc, Pd, Ps, Pe, Pi, Pf, Po) & Symbol (Sc, Sm, Sk, So)
    fixed int64[19]:yes_punct = [
        161i64,    // U+00A1 ¡ (Po)
        163i64,    // U+00A3 £ (Sc) — CommonMark Ex 353
        168i64,    // U+00A8 ¨ (Sk)
        169i64,    // U+00A9 © (So)
        171i64,    // U+00AB « (Pi)
        187i64,    // U+00BB » (Pf)
        191i64,    // U+00BF ¿ (Po)
        215i64,    // U+00D7 × (Sm)
        8212i64,   // U+2014 — (Pd)
        8216i64,   // U+2018 ‘ (Pi)
        8217i64,   // U+2019 ’ (Pf)
        8255i64,   // U+203F ‿ (Pc)
        8364i64,   // U+20AC € (Sc) — CommonMark Ex 353
        8800i64,   // U+2260 ≠ (Sm)
        12283i64,  // U+2FFB ⿻ (So) — last IDC in cmark 0.31.2 utf8.c
        12290i64,  // U+3002 。 (Po)
        12300i64,  // U+300C 「 (Ps)
        12301i64,  // U+300D 」 (Pe)
        128512i64  // U+1F600 😀 (So)
    ];
    for (int64:i in 0i64...19i64) {
        if (!(raw utf8_is_punct(yes_punct[i]))) { pass 111i32; }
    }

    // Representative non-punctuation / non-symbol code points
    // Includes U+2FFC..U+2FFF and U+31EF (Unicode 15.1 additions absent from cmark 0.31.2 utf8.c)
    fixed int64[16]:no_punct = [
        0i64 - 1i64,
        160i64,     // U+00A0 NBSP (Zs)
        192i64,     // U+00C0 À (Lu)
        223i64,     // U+00DF ß (Ll)
        945i64,     // U+03B1 α (Ll)
        1072i64,    // U+0430 а (Ll)
        12284i64,   // U+2FFC (absent in cmark 0.31.2 utf8.c)
        12285i64,   // U+2FFD (absent in cmark 0.31.2 utf8.c)
        12286i64,   // U+2FFE (absent in cmark 0.31.2 utf8.c)
        12287i64,   // U+2FFF (absent in cmark 0.31.2 utf8.c)
        12783i64,   // U+31EF (absent in cmark 0.31.2 utf8.c)
        19968i64,   // U+4E00 一 (Lo)
        55296i64,   // U+D800 surrogate (Cs)
        65535i64,   // U+FFFF noncharacter (Cn)
        1114111i64, // U+10FFFF noncharacter (Cn)
        1114112i64  // out of range
    ];
    for (int64:j in 0i64...16i64) {
        if (raw utf8_is_punct(no_punct[j])) { pass 112i32; }
    }

    pass 0i32;
};

func:test_case_fold = int32() {
    fixed int64[3]:fffd_bs = [239i64, 191i64, 189i64];
    string:fffd = relay mk_bytes(fffd_bs[0i64...3i64]);

    // Empty chunk
    if (!(relay expect_fold("", raw chunk_all(""), ""))) { pass 120i32; }

    // ASCII mixed case + digits + punctuation
    string:s1 = "Hello, World! 123_AZ";
    if (!(relay expect_fold(s1, raw chunk_all(s1), "hello, world! 123_az"))) { pass 121i32; }

    // Latin-1 uppercase -> lowercase (ÉÈÊË Ñ Ö Ü)
    string:s2 = "ÉÈÊË Ñ Ö Ü";
    string:e2 = "éèêë ñ ö ü";
    if (!(relay expect_fold(s2, raw chunk_all(s2), e2))) { pass 122i32; }

    // Greek (CommonMark Ex 206): ΑΓΩ -> αγω; Σ and ς -> σ
    string:s3 = "ΑΓΩ Σς";
    string:e3 = "αγω σσ";
    if (!(relay expect_fold(s3, raw chunk_all(s3), e3))) { pass 123i32; }

    // German sharp S (CommonMark Ex 539): ß (U+00DF) -> ss, ẞ (U+1E9E) -> ss
    string:s4 = "ß ẞ STRASSE";
    if (!(relay expect_fold(s4, raw chunk_all(s4), "ss ss strasse"))) { pass 124i32; }

    // Multi-codepoint folds:
    // U+0130 (İ) -> i + U+0307 (69 CC 87)
    // U+0390 (ΐ) -> U+03B9 U+0308 U+0301 (CE B9 CC 88 CC 81)
    // U+FB01 (ﬁ) -> fi, U+FB03 (ﬃ) -> ffi
    string:s5 = "İ ΐ ﬁ ﬃ";
    fixed int64[18]:e5_bs = [
        105i64, 204i64, 135i64, 32i64,
        206i64, 185i64, 204i64, 136i64, 204i64, 129i64, 32i64,
        102i64, 105i64, 32i64,
        102i64, 102i64, 105i64, 32i64
    ];
    string:s5_sp = "İ ΐ ﬁ ﬃ ";
    string:e5 = relay mk_bytes(e5_bs[0i64...18i64]);
    if (!(relay expect_fold(s5_sp, raw chunk_all(s5_sp), e5))) { pass 125i32; }
    discard(s5);

    // 4-byte astral plane fold: Deseret capital U+10400 (F0 90 90 80) -> U+10428 (F0 90 90 A8)
    fixed int64[4]:s6_bs = [240i64, 144i64, 144i64, 128i64];
    fixed int64[4]:e6_bs = [240i64, 144i64, 144i64, 168i64];
    string:s6 = relay mk_bytes(s6_bs[0i64...4i64]);
    string:e6 = relay mk_bytes(e6_bs[0i64...4i64]);
    if (!(relay expect_fold(s6, raw chunk_all(s6), e6))) { pass 126i32; }

    // Unicode 16 folds present in cmark 0.31.2 spec/case_fold.inc:
    // U+1C89 -> U+1C8A, U+A7CB -> U+0264, U+A7DC -> U+019B, U+10D50 -> U+10D70
    fixed int64[13]:u16_in_bs = [
        225i64, 178i64, 137i64,
        234i64, 159i64, 139i64,
        234i64, 159i64, 156i64,
        240i64, 144i64, 181i64, 144i64
    ];
    fixed int64[11]:u16_exp_bs = [
        225i64, 178i64, 138i64,
        201i64, 164i64,
        198i64, 155i64,
        240i64, 144i64, 181i64, 176i64
    ];
    string:u16_in = relay mk_bytes(u16_in_bs[0i64...13i64]);
    string:u16_exp = relay mk_bytes(u16_exp_bs[0i64...11i64]);
    if (!(relay expect_fold(u16_in, raw chunk_all(u16_in), u16_exp))) { pass 129i32; }

    // Invalid UTF-8 byte in case_fold -> U+FFFD, remaining text still folded
    fixed int64[3]:s7_bs = [65i64, 255i64, 66i64];
    string:s7 = relay mk_bytes(s7_bs[0i64...3i64]);
    string:e7 = string_concat(string_concat("a", fffd), "b");
    if (!(relay expect_fold(s7, raw chunk_all(s7), e7))) { pass 127i32; }

    // Non-zero chunk offset + append onto existing buffer contents
    Buffer:b = relay buffer_create();
    discard(relay buffer_puts(@b, "pre:"));
    string:framed = "ZZẞ_ABzz";
    // "ZZ" is 2 bytes, "ẞ" is 3 bytes, "_AB" is 3 bytes -> chunk [2, 6) = "ẞ_AB"
    discard(relay utf8_case_fold(framed, raw chunk_of(framed, 2i64, 6i64), @b));
    string:got = raw buffer_detach(move(b));
    if (!string_equals(got, "pre:ss_ab")) { pass 128i32; }

    pass 0i32;
};

func:main = int32(cstring[]:_~argv) {
    Result<int32>:r1 = test_iterate();
    if (r1.is_error) { exit 199i32; }
    if (r1.value != 0i32) { exit r1.value; }
    drop print_line("PASS: utf8_iterate\n");

    Result<int32>:r2 = test_encode();
    if (r2.is_error) { exit 200i32; }
    if (r2.value != 0i32) { exit r2.value; }
    drop print_line("PASS: utf8_encode\n");

    Result<int32>:r3 = test_check();
    if (r3.is_error) { exit 201i32; }
    if (r3.value != 0i32) { exit r3.value; }
    drop print_line("PASS: utf8_check\n");

    int32:rc = raw test_is_space();
    if (rc != 0i32) { exit rc; }
    drop print_line("PASS: utf8_is_space\n");

    rc = raw test_is_punct();
    if (rc != 0i32) { exit rc; }
    drop print_line("PASS: utf8_is_punct\n");

    Result<int32>:r6 = test_case_fold();
    if (r6.is_error) { exit 202i32; }
    if (r6.value != 0i32) { exit r6.value; }
    drop print_line("PASS: utf8_case_fold\n");

    drop print_line("ALL cm_utf8 CHECKS PASSED\n");
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (OutOfBounds, IntOverflow, DivByZero, DivOverflow, DecreasesViolated, LimitViolated,
         Unreachable, HeapOom, HeapBadRequest, WildLeak, StackExhausted, MachineFault) { exit 90i32; },
        (*) { exit 99i32; }
    }
};
