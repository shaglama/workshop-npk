// Check harness for Part 3 — cm_escape.
// Written by Neon (Google).
//
// Exercises every function in commonmark/INTERFACES.md Part 3 against
// hand-computed cmark 0.31.2 / CommonMark 0.31.2 expected values.

mod:check_escape;

use "../../buffer/cm_buffer.npk".{
    Buffer, Chunk, buffer_create, buffer_putc, buffer_puts, buffer_detach,
    chunk_of, chunk_all
};
use "../cm_escape.npk".{
    escape_html_into, escape_href_into, unescape_entities_into,
    unescape_backslashes_into, clean_url, clean_title
};

func:print_line = NIL(string:s) never fails {
    fd:out = 1i32 =>! fd;
    Result<int64>:r = write(out, s.ptr, s.len);
    if (r.is_error) { }
    pass NIL;
};

func:mk_bytes = string(fixed int64[]:xs) {
    Buffer:b = relay buffer_create();
    for (int64:i in 0i64...xs.len) {
        discard(relay buffer_putc(@b, xs[i]));
    }
    pass (raw buffer_detach(move(b)));
};

func:expect_html = bool(string:base, Chunk:c, bool:secure, string:expected) {
    Buffer:b = relay buffer_create();
    discard(relay escape_html_into(@b, base, c, secure));
    string:got = raw buffer_detach(move(b));
    pass string_equals(got, expected);
};

func:expect_href = bool(string:base, Chunk:c, string:expected) {
    Buffer:b = relay buffer_create();
    discard(relay escape_href_into(@b, base, c));
    string:got = raw buffer_detach(move(b));
    pass string_equals(got, expected);
};

func:expect_ent = bool(string:base, Chunk:c, string:expected) {
    Buffer:b = relay buffer_create();
    discard(relay unescape_entities_into(@b, base, c));
    string:got = raw buffer_detach(move(b));
    pass string_equals(got, expected);
};

func:expect_bs = bool(string:base, Chunk:c, string:expected) {
    Buffer:b = relay buffer_create();
    discard(relay unescape_backslashes_into(@b, base, c));
    string:got = raw buffer_detach(move(b));
    pass string_equals(got, expected);
};

func:test_escape_html = int32() {
    // Empty & plain text
    if (!(relay expect_html("", raw chunk_all(""), false, ""))) { pass 10i32; }
    if (!(relay expect_html("", raw chunk_all(""), true, ""))) { pass 11i32; }
    string:plain = "Hello, World! 12345 'single'";
    string:plain_sec = "Hello, World! 12345 &#39;single&#39;";
    if (!(relay expect_html(plain, raw chunk_all(plain), false, plain))) { pass 12i32; }
    if (!(relay expect_html(plain, raw chunk_all(plain), true, plain_sec))) { pass 13i32; }

    // Standard HTML characters: & < > ", plus ' and / (only in secure mode)
    string:s1 = "<a href=\"x&y\">a/b'c</a>";
    string:e1_norm = "&lt;a href=&quot;x&amp;y&quot;&gt;a/b'c&lt;/a&gt;";
    string:e1_sec = "&lt;a href=&quot;x&amp;y&quot;&gt;a&#47;b&#39;c&lt;&#47;a&gt;";
    if (!(relay expect_html(s1, raw chunk_all(s1), false, e1_norm))) { pass 14i32; }
    if (!(relay expect_html(s1, raw chunk_all(s1), true, e1_sec))) { pass 15i32; }

    // All escaped chars consecutively
    string:s2 = "\"&/<>'";
    if (!(relay expect_html(s2, raw chunk_all(s2), false, "&quot;&amp;/&lt;&gt;'"))) { pass 16i32; }
    if (!(relay expect_html(s2, raw chunk_all(s2), true, "&quot;&amp;&#47;&lt;&gt;&#39;"))) { pass 17i32; }

    // Regression (reviews/escape.md addendum): apostrophe in secure vs non-secure mode
    if (!(relay expect_html("'", raw chunk_all("'"), true, "&#39;"))) { pass 105i32; }
    if (!(relay expect_html("'", raw chunk_all("'"), false, "'"))) { pass 106i32; }

    // UTF-8 and raw bytes (including NUL and 0xFF) pass through verbatim
    fixed int64[5]:raw_bs = [97i64, 0i64, 38i64, 255i64, 98i64];
    fixed int64[9]:exp_raw_bs = [97i64, 0i64, 38i64, 97i64, 109i64, 112i64, 59i64, 255i64, 98i64];
    string:raw_in = relay mk_bytes(raw_bs[0i64...5i64]);
    string:raw_exp = relay mk_bytes(exp_raw_bs[0i64...9i64]);
    if (!(relay expect_html(raw_in, raw chunk_all(raw_in), false, raw_exp))) { pass 18i32; }

    // Non-zero chunk offset + append onto existing buffer
    Buffer:b = relay buffer_create();
    discard(relay buffer_puts(@b, "pre:"));
    string:framed = "<<a&b/c>>";
    discard(relay escape_html_into(@b, framed, raw chunk_of(framed, 2i64, 5i64), true));
    string:got = raw buffer_detach(move(b));
    if (!string_equals(got, "pre:a&amp;b&#47;c")) { pass 19i32; }

    pass 0i32;
};

func:test_escape_href = int32() {
    // Empty
    if (!(relay expect_href("", raw chunk_all(""), ""))) { pass 20i32; }

    // Safe ASCII characters (all 81 of cmark's HREF_SAFE == 1) stay untouched
    string:safe = "!#$%()*+,-./0123456789:;=?@ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz~";
    if (!(relay expect_href(safe, raw chunk_all(safe), safe))) { pass 21i32; }

    // Special HTML-entity escapes in href: & -> &amp; and ' -> &#x27;
    string:amp_sq = "https://example.com/a'b?q=hello&id=22&boolean";
    string:amp_sq_exp = "https://example.com/a&#x27;b?q=hello&amp;id=22&amp;boolean";
    if (!(relay expect_href(amp_sq, raw chunk_all(amp_sq), amp_sq_exp))) { pass 22i32; }

    // Printable ASCII unsafe characters percent-encoded with uppercase hex
    string:unsafe_ascii = " \"<>[]\\^`{|}";
    string:unsafe_exp = "%20%22%3C%3E%5B%5D%5C%5E%60%7B%7C%7D";
    if (!(relay expect_href(unsafe_ascii, raw chunk_all(unsafe_ascii), unsafe_exp))) { pass 23i32; }

    // Control characters and DEL
    fixed int64[5]:ctrl_bs = [0i64, 9i64, 10i64, 31i64, 127i64];
    string:ctrl = relay mk_bytes(ctrl_bs[0i64...5i64]);
    if (!(relay expect_href(ctrl, raw chunk_all(ctrl), "%00%09%0A%1F%7F"))) { pass 24i32; }

    // UTF-8 multibyte & high bytes (CommonMark Ex 502 / 506)
    string:uml = "foo%20bä";
    if (!(relay expect_href(uml, raw chunk_all(uml), "foo%20b%C3%A4"))) { pass 25i32; }
    string:foo_uml = "/föö";
    if (!(relay expect_href(foo_uml, raw chunk_all(foo_uml), "/f%C3%B6%C3%B6"))) { pass 26i32; }
    fixed int64[3]:hi_bs = [128i64, 160i64, 255i64];
    string:hi = relay mk_bytes(hi_bs[0i64...3i64]);
    if (!(relay expect_href(hi, raw chunk_all(hi), "%80%A0%FF"))) { pass 27i32; }

    // Non-zero chunk offset + append onto existing buffer
    Buffer:b = relay buffer_create();
    discard(relay buffer_puts(@b, "href="));
    string:framed = "XX/my uri&xYY";
    discard(relay escape_href_into(@b, framed, raw chunk_of(framed, 2i64, 9i64)));
    string:got = raw buffer_detach(move(b));
    if (!string_equals(got, "href=/my%20uri&amp;x")) { pass 28i32; }

    pass 0i32;
};

func:test_unescape_entities = int32() {
    fixed int64[3]:fffd_bs = [239i64, 191i64, 189i64];
    string:fffd = relay mk_bytes(fffd_bs[0i64...3i64]);

    // Empty & no ampersands
    if (!(relay expect_ent("", raw chunk_all(""), ""))) { pass 30i32; }
    if (!(relay expect_ent("plain text", raw chunk_all("plain text"), "plain text"))) { pass 31i32; }

    // CommonMark spec §2.5 named entities (including 2-codepoint &ngE; and max-len 31)
    string:spec_named = "&nbsp; &amp; &copy; &AElig; &Dcaron; &frac34; &HilbertSpace; &DifferentialD; &ClockwiseContourIntegral; &ngE;";
    string:spec_named_exp = "  & © Æ Ď ¾ ℋ ⅆ ∲ ≧̸";
    if (!(relay expect_ent(spec_named, raw chunk_all(spec_named), spec_named_exp))) { pass 32i32; }

    // Boundary entries in sorted table: first (AElig), shortest (ac, lt, gt), longest (31), last (zwnj)
    string:bounds = "&AElig;&ac;&lt;&gt;&CounterClockwiseContourIntegral;&zwnj;";
    // Æ (C3 86), ∾ (E2 88 BE), < (3C), > (3E), ∳ (E2 88 B3), U+200C (E2 80 8C)
    fixed int64[13]:bounds_bs = [
        195i64, 134i64,
        226i64, 136i64, 190i64,
        60i64, 62i64,
        226i64, 136i64, 179i64,
        226i64, 128i64, 140i64
    ];
    string:bounds_exp = relay mk_bytes(bounds_bs[0i64...13i64]);
    if (!(relay expect_ent(bounds, raw chunk_all(bounds), bounds_exp))) { pass 33i32; }

    // Case sensitivity: &AElig; != &aelig; and &Aelig; is unknown
    if (!(relay expect_ent("&AElig;&aelig;&Aelig;", raw chunk_all("&AElig;&aelig;&Aelig;"), "Ææ&Aelig;"))) { pass 34i32; }

    // Decimal numeric character references (CommonMark §2.5)
    string:dec_in = "&#35; &#1234; &#992; &#0;";
    string:dec_exp = string_concat("# Ӓ Ϡ ", fffd);
    if (!(relay expect_ent(dec_in, raw chunk_all(dec_in), dec_exp))) { pass 35i32; }

    // Decimal boundaries: 7 digits valid, 8 digits rejected; surrogates & > U+10FFFF -> U+FFFD; U+FFFF valid
    if (!(relay expect_ent("&#0000035;", raw chunk_all("&#0000035;"), "#"))) { pass 36i32; }
    if (!(relay expect_ent("&#00000035;", raw chunk_all("&#00000035;"), "&#00000035;"))) { pass 37i32; }
    if (!(relay expect_ent("&#55296;", raw chunk_all("&#55296;"), fffd))) { pass 38i32; }
    if (!(relay expect_ent("&#57343;", raw chunk_all("&#57343;"), fffd))) { pass 39i32; }
    if (!(relay expect_ent("&#1114112;", raw chunk_all("&#1114112;"), fffd))) { pass 40i32; }
    fixed int64[4]:u10ffff_bs = [244i64, 143i64, 191i64, 191i64];
    string:u10ffff = relay mk_bytes(u10ffff_bs[0i64...4i64]);
    if (!(relay expect_ent("&#1114111;", raw chunk_all("&#1114111;"), u10ffff))) { pass 41i32; }
    fixed int64[3]:uffff_bs = [239i64, 191i64, 191i64];
    string:uffff = relay mk_bytes(uffff_bs[0i64...3i64]);
    if (!(relay expect_ent("&#65535;", raw chunk_all("&#65535;"), uffff))) { pass 42i32; }

    // Hexadecimal numeric character references (CommonMark §2.5)
    string:hex_in = "&#X22; &#XD06; &#xcab;";
    if (!(relay expect_ent(hex_in, raw chunk_all(hex_in), "\" ആ ಫ"))) { pass 43i32; }
    if (!(relay expect_ent("&#x0;", raw chunk_all("&#x0;"), fffd))) { pass 44i32; }
    if (!(relay expect_ent("&#X000041;", raw chunk_all("&#X000041;"), "A"))) { pass 45i32; }
    if (!(relay expect_ent("&#X0000041;", raw chunk_all("&#X0000041;"), "&#X0000041;"))) { pass 46i32; }
    if (!(relay expect_ent("&#x10FFFF;", raw chunk_all("&#x10FFFF;"), u10ffff))) { pass 47i32; }
    if (!(relay expect_ent("&#x110000;", raw chunk_all("&#x110000;"), fffd))) { pass 48i32; }
    if (!(relay expect_ent("&#xD800;", raw chunk_all("&#xD800;"), fffd))) { pass 49i32; }

    // Non-entities left completely unchanged (CommonMark §2.5)
    string:non_ent = "&nbsp &x; &#; &#x; &#87654321; &#abcdef0; &ThisIsNotDefined; &hi?; &copy &MadeUpEntity; &";
    if (!(relay expect_ent(non_ent, raw chunk_all(non_ent), non_ent))) { pass 50i32; }

    // Back-to-back ampersands: first '&' fails, second '&amp;' succeeds
    if (!(relay expect_ent("&&amp;", raw chunk_all("&&amp;"), "&&"))) { pass 51i32; }
    if (!(relay expect_ent("&foo&lt;", raw chunk_all("&foo&lt;"), "&foo<"))) { pass 52i32; }

    // Chunk boundary must not peek at ';' outside the chunk
    string:framed = "x&amp;y";
    if (!(relay expect_ent(framed, raw chunk_of(framed, 1i64, 4i64), "&amp"))) { pass 53i32; }
    if (!(relay expect_ent(framed, raw chunk_of(framed, 1i64, 5i64), "&"))) { pass 54i32; }

    pass 0i32;
};

func:test_unescape_backslashes = int32() {
    if (!(relay expect_bs("", raw chunk_all(""), ""))) { pass 60i32; }

    // All 32 ASCII punctuation characters backslash-escaped (CommonMark Ex 12)
    string:all_p_in = "\\!\\\"\\#\\$\\%\\&\\'\\(\\)\\*\\+\\,\\-\\.\\/\\:\\;\\<\\=\\>\\?\\@\\[\\\\\\]\\^\\_\\`\\{\\|\\}\\~";
    string:all_p_exp = "!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~";
    if (!(relay expect_bs(all_p_in, raw chunk_all(all_p_in), all_p_exp))) { pass 61i32; }

    // Backslashes before non-punctuation characters are kept (CommonMark Ex 13)
    string:non_p = "\\→\\A\\a\\ \\3\\φ\\«";
    if (!(relay expect_bs(non_p, raw chunk_all(non_p), non_p))) { pass 62i32; }

    // Consecutive backslashes
    if (!(relay expect_bs("\\\\*", raw chunk_all("\\\\*"), "\\*"))) { pass 63i32; }
    if (!(relay expect_bs("\\\\a", raw chunk_all("\\\\a"), "\\a"))) { pass 64i32; }
    if (!(relay expect_bs("\\\\\\\\", raw chunk_all("\\\\\\\\"), "\\\\"))) { pass 65i32; }
    if (!(relay expect_bs("\\\\\\*", raw chunk_all("\\\\\\*"), "\\*"))) { pass 66i32; }

    // Trailing backslash at end of string and at chunk boundary (with '*' right outside chunk)
    if (!(relay expect_bs("foo\\", raw chunk_all("foo\\"), "foo\\"))) { pass 67i32; }
    string:framed = "foo\\*bar";
    if (!(relay expect_bs(framed, raw chunk_of(framed, 0i64, 4i64), "foo\\"))) { pass 68i32; }
    if (!(relay expect_bs(framed, raw chunk_of(framed, 0i64, 5i64), "foo*"))) { pass 69i32; }

    // Appending onto existing buffer
    Buffer:b = relay buffer_create();
    discard(relay buffer_puts(@b, "pre:"));
    discard(relay unescape_backslashes_into(@b, "a\\*b\\c", raw chunk_all("a\\*b\\c")));
    string:got = raw buffer_detach(move(b));
    if (!string_equals(got, "pre:a*b\\c")) { pass 70i32; }

    pass 0i32;
};

func:test_clean_url_and_title = int32() {
    // clean_url: empty and whitespace-only
    string:u0 = relay clean_url("", raw chunk_all(""));
    if (!string_equals(u0, "")) { pass 80i32; }
    string:u1 = relay clean_url(" \t\r\n ", raw chunk_all(" \t\r\n "));
    if (!string_equals(u1, "")) { pass 81i32; }

    // clean_url: trim + entity-unescape + backslash-unescape
    string:in2 = "  \t/f&ouml;\\*\\a\n ";
    string:u2 = relay clean_url(in2, raw chunk_all(in2));
    if (!string_equals(u2, "/fö*\\a")) { pass 82i32; }

    // clean_url: order checks
    // 1) trim BEFORE entity-unescape preserves entity-decoded spaces (cmark_clean_url)
    string:in3 = "  &#32;/foo&#32;  ";
    string:u3 = relay clean_url(in3, raw chunk_all(in3));
    if (!string_equals(u3, " /foo ")) { pass 83i32; }

    // 2) entity-unescape BEFORE backslash-unescape:
    //    "&#92;*" -> "\*" -> "*"
    //    "\&quot;" -> "\"" -> "\""
    //    "\\&amp;" -> "\\&" -> "\&"
    string:in4 = "&#92;*";
    string:u4 = relay clean_url(in4, raw chunk_all(in4));
    if (!string_equals(u4, "*")) { pass 84i32; }

    string:in5 = "\\&quot;";
    string:u5 = relay clean_url(in5, raw chunk_all(in5));
    if (!string_equals(u5, "\"")) { pass 85i32; }

    string:in6 = "\\\\&amp;";
    string:u6 = relay clean_url(in6, raw chunk_all(in6));
    if (!string_equals(u6, "\\&")) { pass 86i32; }

    // clean_url: Spec Ex 202
    string:in7 = "/url\\bar\\*baz";
    string:u7 = relay clean_url(in7, raw chunk_all(in7));
    if (!string_equals(u7, "/url\\bar*baz")) { pass 87i32; }

    // clean_url: non-zero chunk offset
    string:framed_u = "ZZ  /a&amp;b\\+c  ZZ";
    string:u8 = relay clean_url(framed_u, raw chunk_of(framed_u, 2i64, 15i64));
    if (!string_equals(u8, "/a&b+c")) { pass 88i32; }

    // clean_title: empty and empty delimited forms, plus single quote (no underflow)
    string:t0 = relay clean_title("", raw chunk_all(""));
    if (!string_equals(t0, "")) { pass 90i32; }
    string:t1 = relay clean_title("\"\"", raw chunk_all("\"\""));
    if (!string_equals(t1, "")) { pass 91i32; }
    string:t2 = relay clean_title("''", raw chunk_all("''"));
    if (!string_equals(t2, "")) { pass 92i32; }
    string:t3 = relay clean_title("()", raw chunk_all("()"));
    if (!string_equals(t3, "")) { pass 93i32; }
    string:t4 = relay clean_title("\"", raw chunk_all("\""));
    if (!string_equals(t4, "\"")) { pass 94i32; }

    // clean_title: strips matching outer "...", '...', (...)
    string:t5 = relay clean_title("\"title \\\"&quot;\"", raw chunk_all("\"title \\\"&quot;\""));
    if (!string_equals(t5, "title \"\"")) { pass 95i32; }
    string:t6 = relay clean_title("'title (with parens)'", raw chunk_all("'title (with parens)'"));
    if (!string_equals(t6, "title (with parens)")) { pass 96i32; }
    string:t7 = relay clean_title("(f&ouml;\\*&#92;*)", raw chunk_all("(f&ouml;\\*&#92;*)"));
    if (!string_equals(t7, "fö**")) { pass 97i32; }

    // clean_title: preserves inner leading/trailing whitespace (CommonMark Ex 193)
    string:t8_in = "'\ntitle\nline1\nline2\n'";
    string:t8 = relay clean_title(t8_in, raw chunk_all(t8_in));
    if (!string_equals(t8, "\ntitle\nline1\nline2\n")) { pass 98i32; }
    string:t9_in = "\"  spaced  \"";
    string:t9 = relay clean_title(t9_in, raw chunk_all(t9_in));
    if (!string_equals(t9, "  spaced  ")) { pass 99i32; }

    // clean_title: mismatched delimiters or unquoted titles are not stripped
    string:t10_in = "\"mismatched'";
    string:t10 = relay clean_title(t10_in, raw chunk_all(t10_in));
    if (!string_equals(t10, "\"mismatched'")) { pass 100i32; }
    string:t11_in = "foo\\\"bar\\baz";
    string:t11 = relay clean_title(t11_in, raw chunk_all(t11_in));
    if (!string_equals(t11, "foo\"bar\\baz")) { pass 101i32; }

    // clean_title: non-zero chunk offset
    string:framed_t = "XX'\\&quot;ok'YY";
    string:t12 = relay clean_title(framed_t, raw chunk_of(framed_t, 2i64, 11i64));
    if (!string_equals(t12, "\"ok")) { pass 102i32; }

    pass 0i32;
};

func:main = int32(cstring[]:_~argv) {
    Result<int32>:r1 = test_escape_html();
    if (r1.is_error) { exit 199i32; }
    if (r1.value != 0i32) { exit r1.value; }
    drop print_line("PASS: escape_html_into\n");

    Result<int32>:r2 = test_escape_href();
    if (r2.is_error) { exit 200i32; }
    if (r2.value != 0i32) { exit r2.value; }
    drop print_line("PASS: escape_href_into\n");

    Result<int32>:r3 = test_unescape_entities();
    if (r3.is_error) { exit 201i32; }
    if (r3.value != 0i32) { exit r3.value; }
    drop print_line("PASS: unescape_entities_into\n");

    Result<int32>:r4 = test_unescape_backslashes();
    if (r4.is_error) { exit 202i32; }
    if (r4.value != 0i32) { exit r4.value; }
    drop print_line("PASS: unescape_backslashes_into\n");

    Result<int32>:r5 = test_clean_url_and_title();
    if (r5.is_error) { exit 203i32; }
    if (r5.value != 0i32) { exit r5.value; }
    drop print_line("PASS: clean_url & clean_title\n");

    drop print_line("ALL cm_escape CHECKS PASSED\n");
    exit 0i32;
};

func:failsafe = int32(Error:e) {
    pick (e) {
        (OutOfBounds, IntOverflow, DivByZero, DivOverflow, DecreasesViolated, LimitViolated,
         Unreachable, HeapOom, HeapBadRequest, WildLeak, StackExhausted, MachineFault) { exit 90i32; },
        (*) { exit 99i32; }
    }
};
