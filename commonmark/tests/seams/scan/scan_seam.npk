func:at_end = bool(int64:id, string:s) never fails {
    int64:r = raw run(id, s, s.len);
    pass r == 0i64;
};

// CHECK_ALL_BEGIN
func:check_all = int32() {
    if (!(relay g11())) { pass 11i32; }
    if (!(relay g12())) { pass 12i32; }
    if (!(relay g13())) { pass 13i32; }
    if (!(relay g14())) { pass 14i32; }
    if (!(relay g15())) { pass 15i32; }
    if (!(relay g16())) { pass 16i32; }
    if (!(relay g17())) { pass 17i32; }
    if (!(relay g18())) { pass 18i32; }
    if (!(relay g19())) { pass 19i32; }
    if (!(relay g20())) { pass 20i32; }
    if (!(relay g21())) { pass 21i32; }
    if (!(relay g22())) { pass 22i32; }
    if (!(relay g23())) { pass 23i32; }
    if (!(relay g24())) { pass 24i32; }
    if (!(relay g25())) { pass 25i32; }
    if (!(relay g26())) { pass 26i32; }
    pass 0i32;
};
// CHECK_ALL_END

func:main = int32(cstring[]:_~argv) {
    Result<int32>:outcome = check_all();
    if (outcome.is_error) { !!! outcome.err; }
    exit outcome.value;
};

// Any returned error is forwarded here unchanged by main.
func:failsafe = int32(Error:err) {
    pick (err) {
        (Unreachable, HeapOom, HeapBadRequest, WildLeak, StackExhausted,
         MachineFault, DivByZero, DivOverflow, IntOverflow, OutOfBounds,
         DecreasesViolated) { exit 100i32; },
        (*) { exit 100i32; }
    }
};
