// one case at offset 0, and again at offset 3 behind a 'xyz' prefix (no look-behind)
func:chk = bool(int64:id, string:s, int64:want) {
    int64:a = raw run(id, s, 0i64);
    if (a != want) { pass false; }
    Buffer:buf = relay buffer_create();
    relay buffer_puts(@buf, "xyz");
    relay buffer_puts(@buf, s);
    string:p = raw buffer_detach(move(buf));
    int64:b = raw run(id, p, 3i64);
    pass b == want;
};

