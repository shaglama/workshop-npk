    if (!(relay chk(21i64, " 'a'", 0i64))) { pass false; }
    if (!(relay chk(21i64, "(a\n\nb)", 6i64))) { pass false; }
    pass true;
};

// group 25: dangerous url: javascript: vbscript: file: data: (not data:image/png|gif|jpeg|webp); length of the scheme and colon
func:g25 = bool() {
