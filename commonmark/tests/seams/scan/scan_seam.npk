    if (!(relay chk(22i64, "js:", 0i64))) { pass false; }
    if (!(relay chk(22i64, "https://javascript:", 0i64))) { pass false; }
    if (!(relay chk(22i64, "FILE:x", 5i64))) { pass false; }
    if (!(relay chk(22i64, "mailto:x", 0i64))) { pass false; }
    if (!(relay chk(22i64, "", 0i64))) { pass false; }
